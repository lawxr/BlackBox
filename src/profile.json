{
  "version": 2,
  "error_keys": {"code": "error", "message": "mensaje"},
  "errors": {
    "E001": {"status": 401, "mensaje": "no autorizado"},
    "E100": {"status": 400, "mensaje": "json inválido"},
    "E102": {"status": 400, "mensaje": "falta m"},
    "E103": {"status": 400, "mensaje": "falta control"},
    "E104": {"status": 400, "mensaje": "segmento vacío"},
    "E201": {"status": 400, "mensaje": "control mal formado"},
    "E202": {"status": 400, "mensaje": "control inválido"},
    "E301": {"status": 400, "mensaje": "comando desconocido "},
    "E302": {"status": 400, "mensaje": "aridad inválida"},
    "E303": {"status": 400, "mensaje": "monto inválido"},
    "E304": {"status": 400, "mensaje": "origen y destino iguales"},
    "E401": {"status": 404, "mensaje": "cuenta inexistente"},
    "E402": {"status": 404, "mensaje": "operación inexistente"},
    "E404": {"status": 404, "mensaje": "ruta desconocida"},
    "E506": {"status": 422, "mensaje": "límite excedido"},
    "E507": {"status": 422, "mensaje": "saldo insuficiente"},
    "E520": {"status": 409, "mensaje": "operación destructiva: detiene el servicio; reenvía con confirmación"}
  },
  "http": {
    "auth": {"scheme": "Bearer", "error": "E001"},
    "unknown_route_error": "E404",
    "routes": [
      {"method": "GET", "path": "/health", "kind": "health", "status": 200, "body": {"ok": true}},
      {"method": "POST", "path": "/__reset", "kind": "reset", "status": 200, "body": {"ok": true}},
      {"method": "POST", "path": "/msg", "kind": "message"}
    ],
    "invalid_json_error": "E100",
    "message_field": "m",
    "missing_message_error": "E102"
  },
  "message": {
    "separator": ";",
    "case_insensitive_commands": true,
    "precedence": [
      {"stage": "missing_control", "error": "E103"},
      {"stage": "empty_segment", "error": "E104"},
      {"stage": "control_format", "error": "E201", "max_digits": 2},
      {"stage": "control_value", "error": "E202"},
      {"stage": "command", "error": "E301"},
      {"stage": "arity", "error": "E302"},
      {"stage": "handler"}
    ],
    "suggestion": {"key": "sugerencia", "max_distance": 2}
  },
  "amount_pattern": "[1-9][0-9]{0,9}",
  "transfer_limit": 50000,
  "id_formats": {"account": "AC-{n:04d}", "operation": "OP-{n:04d}"},
  "commands": {
    "PING": {
      "kind": "pong", "segments": 2, "control": false,
      "response": {"status": 200, "body": {"pong": true}}
    },
    "ALTA": {
      "kind": "create_account", "segments": 3, "name_arg": 1,
      "response": {"status": 201, "body": {"cuentaId": "{account}"}}
    },
    "CONSULTA": {
      "kind": "query_account", "segments": 3, "account_arg": 1, "balance_format": "decimal",
      "checks": [{"check": "account_exists", "args": [1], "error": "E401"}],
      "response": {"status": 200, "body": {"cuenta_id": "{account}", "saldo": "{balance}"}}
    },
    "DEPOSITO": {
      "kind": "credit", "segments": 4, "account_arg": 1, "amount_arg": 2,
      "checks": [
        {"check": "amount", "args": [2], "error": "E303"},
        {"check": "account_exists", "args": [1], "error": "E401"}
      ],
      "response": {"status": 200, "body": {"status": "recieved", "operacionId": "{operation}"}}
    },
    "TRANSFER": {
      "kind": "transfer", "segments": 5, "source_arg": 1, "target_arg": 2, "amount_arg": 3,
      "checks": [
        {"check": "amount", "args": [3], "error": "E303"},
        {"check": "distinct", "args": [1, 2], "error": "E304"},
        {"check": "account_exists", "args": [1, 2], "error": "E401"},
        {"check": "max_amount", "args": [3], "limit": "transfer_limit", "error": "E506"},
        {"check": "sufficient_balance", "args": [1, 3], "error": "E507"}
      ],
      "response": {"status": 200, "body": {"status": "recieved", "operacionId": "{operation}"}}
    },
    "ANULA": {
      "kind": "annul", "segments": 3, "operation_arg": 1,
      "checks": [{"check": "operation_exists", "args": [1], "error": "E402"}],
      "response": {"status": 200, "body": {"ok": true, "anulada": "{operation}"}},
      "already_annulled": {"status": 200, "body": {"ok": false, "motivo": "ya anulada"}}
    },
    "HALT": {
      "kind": "refuse", "segments": 3, "error": "E520"
    }
  }
}
